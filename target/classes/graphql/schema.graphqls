type Query {
    students(after: String, limit: Int): StudentPage!
    student(id: ID!): Student
    courses(after: String, limit: Int): CoursePage!
    course(id: ID!): Course
    faculty: [Faculty!]!
    facultyMember(id: ID!): Faculty
    locations: [CampusLocation!]!
    location(id: ID!): CampusLocation
    schedules(start: String, end: String): [CourseSchedule!]!
    schedule(id: ID!): CourseSchedule
}

type Mutation {
    createStudent(input: StudentInput!): Student!
    createCourse(input: CourseInput!): Course!
    createFaculty(input: FacultyInput!): Faculty!
    createSchedule(input: ScheduleInput!): CourseSchedule!
}

type StudentPage {
    data: [Student!]!
    nextCursor: String
    hasMore: Boolean!
    count: Int!
}

type CoursePage {
    data: [Course!]!
    nextCursor: String
    hasMore: Boolean!
    count: Int!
}

type Student {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    status: String!
    major: String
    enrollmentYear: Int
}

type Course {
    id: ID!
    code: String!
    title: String!
    description: String
    category: String
    status: String!
    credits: Int
    price: String
    instructor: Faculty
}

type Faculty {
    id: ID!
    firstName: String!
    lastName: String!
    email: String!
    department: String
    title: String
    status: String!
    courses: [Course!]
}

type CampusLocation {
    id: ID!
    name: String!
    type: String
    building: String
    room: String
    capacity: Int
    latitude: Float
    longitude: Float
    address: String
}

type CourseSchedule {
    id: ID!
    course: Course
    location: CampusLocation
    startTime: String
    endTime: String
    recurrenceRule: String
    status: String
}

input StudentInput {
    firstName: String!
    lastName: String!
    email: String!
    status: String
    major: String
    enrollmentYear: Int
}

input CourseInput {
    code: String!
    title: String!
    description: String
    category: String
    status: String
    credits: Int
    price: String
    instructorId: ID
}

input FacultyInput {
    firstName: String!
    lastName: String!
    email: String!
    department: String
    title: String
    status: String
}

input ScheduleInput {
    courseId: ID!
    locationId: ID!
    startTime: String!
    endTime: String!
    recurrenceRule: String
    status: String
}
